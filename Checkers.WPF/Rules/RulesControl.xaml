<UserControl x:Class="Checkers.WPF.Rules.RulesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Rules"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance local:RulesViewModel}">
    <UserControl.Resources>
        <Style x:Key="RuleBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="RuleHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="40,32" Margin="20" Width="860" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Rules.Title}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
            <Button DockPanel.Dock="Bottom" Content="{loc:T Common.Back}" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="Back" Margin="0,16,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:T Rules.GoalTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.Goal}" />

                    <TextBlock Text="{loc:T Rules.MovingTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.Moving}" />

                    <TextBlock Text="{loc:T Rules.CapturingTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.Capturing}" />

                    <TextBlock Text="{loc:T Rules.KingsTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.Kings}" />

                    <TextBlock Text="{loc:T Rules.AmericanTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.American}" />

                    <TextBlock Text="{loc:T Rules.EuropeanTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Text="{loc:T Rules.European}" />

                    <TextBlock Text="{loc:T Rules.DrawsTitle}" Style="{StaticResource RuleHeadingStyle}" />
                    <TextBlock Style="{StaticResource RuleBodyStyle}" Margin="0" Text="{loc:T Rules.Draws}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
