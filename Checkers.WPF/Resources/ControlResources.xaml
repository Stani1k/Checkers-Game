<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="clr-namespace:Checkers.WPF.Settings"
                    xmlns:mainMenu="clr-namespace:Checkers.WPF.MainMenu"
                    xmlns:converters="clr-namespace:Checkers.WPF.Converters"
                    xmlns:players="clr-namespace:Checkers.WPF.Players"
                    xmlns:rules="clr-namespace:Checkers.WPF.Rules"
                    xmlns:game="clr-namespace:Checkers.WPF.Game">
    
    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    
    <!-- Data Templates -->
    <DataTemplate DataType="{x:Type mainMenu:MainMenuViewModel}">
        <mainMenu:MainMenuControl />
    </DataTemplate>
        
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
        <settings:SettingsControl />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type players:PlayerMenuViewModel}">
        <players:PlayerMenuControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type rules:RulesViewModel}">
        <rules:RulesControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type game:GameViewModel}">
        <game:GameControl />
    </DataTemplate>
    
</ResourceDictionary>

