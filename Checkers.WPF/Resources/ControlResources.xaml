<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gameMenu="clr-namespace:Checkers.WPF.GameMenu"
                    xmlns:settings="clr-namespace:Checkers.WPF.Settings"
                    xmlns:mainMenu="clr-namespace:Checkers.WPF.MainMenu">
    
    <DataTemplate DataType="{x:Type mainMenu:MainMenuViewModel}">
        <mainMenu:MainMenuControl />
    </DataTemplate>
        
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
        <settings:SettingsControl />
    </DataTemplate>
    <DataTemplate DataType="{x:Type gameMenu:GameMenuViewModel}">
        <gameMenu:GameMenuControl />
    </DataTemplate>
        
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
</ResourceDictionary>