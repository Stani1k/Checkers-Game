<UserControl x:Class="Checkers.WPF.Game.GameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Game"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance local:GameViewModel}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Stretch="Uniform">
            <Border BorderBrush="#3B2A1A" BorderThickness="6"
                    Width="{Binding BoardWidthAndHeight}" Height="{Binding BoardWidthAndHeight}">
                <ItemsControl ItemsSource="{Binding Squares}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Columns="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SquareViewModel}">
                            <Grid MouseLeftButtonUp="Square_OnMouseLeftButtonUp" Background="Transparent">
                                <Rectangle x:Name="Background" Fill="#EBD9B4" />
                                <Rectangle x:Name="LastMove" Fill="#80F2E34C" Visibility="Collapsed" />
                                <Rectangle x:Name="Selection" Stroke="#FFD500" StrokeThickness="5" Margin="2"
                                           Visibility="Collapsed" />
                                <Ellipse x:Name="Piece" Margin="10" Visibility="Collapsed"
                                         Fill="#F5F1E6" Stroke="#8A7A5A" StrokeThickness="3" />
                                <TextBlock x:Name="Crown" Text="♛" FontSize="34" Foreground="Goldenrod"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <Ellipse x:Name="Target" Width="26" Height="26" Fill="#CC2E9E4F"
                                         Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter TargetName="Background" Property="Fill" Value="#8B5E3C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLastMove}" Value="True">
                                    <Setter TargetName="LastMove" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPiece}" Value="True">
                                    <Setter TargetName="Piece" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTopPiece}" Value="True">
                                    <Setter TargetName="Piece" Property="Fill" Value="#3A2323" />
                                    <Setter TargetName="Piece" Property="Stroke" Value="#150C0C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKing}" Value="True">
                                    <Setter TargetName="Crown" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                    <Setter TargetName="Target" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Viewbox>

        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center" MinWidth="320">
            <TextBlock Text="{Binding StatusText}" FontSize="26" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,15" />
            <TextBlock Text="{Binding ScoreText}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,25" />
            <Button Content="New Game" Style="{StaticResource MainMenuButtonStyle}"
                    Command="{Binding NewGameCommand}" />
            <Button Content="Main Menu" Style="{StaticResource MainMenuButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="MainMenu" />
        </StackPanel>
    </Grid>
</UserControl>
