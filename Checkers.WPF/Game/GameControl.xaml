<UserControl x:Class="Checkers.WPF.Game.GameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Game"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance local:GameViewModel}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Stretch="Uniform">
            <Border BorderBrush="{StaticResource BoardFrameBrush}" BorderThickness="6"
                    Width="{Binding BoardWidthAndHeight}" Height="{Binding BoardWidthAndHeight}">
                <ItemsControl ItemsSource="{Binding Squares}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Columns="{Binding DataContext.BoardSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SquareViewModel}">
                            <Grid MouseLeftButtonUp="Square_OnMouseLeftButtonUp" Background="Transparent">
                                <Rectangle x:Name="Background" Fill="{StaticResource BoardLightSquareBrush}" />
                                <Rectangle x:Name="LastMove" Fill="{StaticResource LastMoveBrush}" Visibility="Collapsed" />
                                <Rectangle x:Name="Selection" Stroke="{StaticResource SelectionBrush}" StrokeThickness="5" Margin="2"
                                           Visibility="Collapsed" />
                                <Ellipse x:Name="Piece" Margin="10" Visibility="Collapsed"
                                         Fill="{StaticResource LightPieceFillBrush}" Stroke="{StaticResource LightPieceStrokeBrush}" StrokeThickness="3" />
                                <TextBlock x:Name="Crown" Text="♛" FontSize="34" Foreground="{StaticResource CrownBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <Ellipse x:Name="Target" Width="26" Height="26" Fill="{StaticResource TargetBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter TargetName="Background" Property="Fill" Value="{StaticResource BoardDarkSquareBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLastMove}" Value="True">
                                    <Setter TargetName="LastMove" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPiece}" Value="True">
                                    <Setter TargetName="Piece" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTopPiece}" Value="True">
                                    <Setter TargetName="Piece" Property="Fill" Value="{StaticResource DarkPieceFillBrush}" />
                                    <Setter TargetName="Piece" Property="Stroke" Value="{StaticResource DarkPieceStrokeBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKing}" Value="True">
                                    <Setter TargetName="Crown" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                    <Setter TargetName="Target" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Viewbox>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="30,0,0,0" VerticalAlignment="Center" MinWidth="340">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,24" />
                <Button Content="New Game" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewGameCommand}" />
                <Button Content="Main Menu" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding UpdateViewCommand}" CommandParameter="MainMenu" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

