<UserControl x:Class="Checkers.WPF.Game.GameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Game"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance local:GameViewModel}"
             Background="White"
             Loaded="GameControl_OnLoaded">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="5"
                Width="{Binding RowHeightAndWidth}" 
                Height="{Binding RowHeightAndWidth}">
            <Canvas Name="GameArea" ClipToBounds="True">

            </Canvas>
        </Border>
    </Grid>
</UserControl>
