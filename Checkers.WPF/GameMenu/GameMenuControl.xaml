<UserControl x:Class="Checkers.WPF.GameMenu.GameMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.GameMenu"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
             Name="Control">
    
    <Grid DataContext="{Binding ElementName=Control, Path=ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding TimeLeft}"/>
        <Grid Grid.Row="1" Name="LayoutRoot" />
    </Grid>
</UserControl>
