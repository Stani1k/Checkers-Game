<UserControl x:Class="Checkers.WPF.Notices.NoticesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Notices"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance local:NoticesViewModel}">

    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="40,32" Margin="20" Width="860" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Notices.Title}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Notices.Intro}" Style="{StaticResource SubtitleTextStyle}"
                       TextAlignment="Center" FontSize="14" Margin="0,0,0,16" />
            <Button DockPanel.Dock="Bottom" Content="{loc:T Common.Back}" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="Settings" Margin="0,16,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:T Notices.Packages}" Style="{StaticResource HeadingTextStyle}" FontSize="20" />
                    <ItemsControl ItemsSource="{Binding Document.Packages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:NoticePackage}">
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnRequestNavigate"
                                                           Foreground="{DynamicResource AccentHoverBrush}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"
                                                     FontWeight="Normal" FontSize="13" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{loc:T Notices.UsedBy}" /><Run Text=": " /><Run Text="{Binding UsedBy, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                                Padding="10,2" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding License}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T Notices.Licenses}" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,18,0,10" />
                    <ItemsControl ItemsSource="{Binding Document.Licenses}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:NoticeLicense}">
                                <Expander Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <StackPanel Margin="22,8,0,4">
                                        <TextBlock Text="{Binding Copyright}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AppliesTo}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 FontFamily="Consolas" FontSize="12" Padding="10"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                                 Foreground="{DynamicResource ForegroundBrush}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
