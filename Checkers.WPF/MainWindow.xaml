<Window x:Class="Checkers.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Checkers Game" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Welcome to the Game Checkers" 
                   HorizontalAlignment="Center"
                   FontSize="30"/>
        <ContentControl Grid.Row="1" 
                        Content="{Binding SelectedViewModel}"/>
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style x:Key="MainMenuButtonStyle" TargetType="Button">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </StackPanel.Resources>
            <Button Content="Start Game" Style="{StaticResource MainMenuButtonStyle}" />
            <Button Content="Settings"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Command="{Binding UpdateViewCommand}"
                    CommandParameter="Settings"/>
            <Button Content="Quit"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Click="Quit_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
