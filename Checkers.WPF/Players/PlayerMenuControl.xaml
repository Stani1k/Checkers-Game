<UserControl x:Class="Checkers.WPF.Players.PlayerMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Checkers.Tools.Models;assembly=Checkers.Tools"
             xmlns:players="clr-namespace:Checkers.WPF.Players"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance players:PlayerMenuViewModel}">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{loc:T Players.Title}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,24" />

        <ItemsControl ItemsSource="{Binding Players}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="12" Width="420">
                        <StackPanel>
                            <TextBlock Text="{Binding PlayerNumberText}" Style="{StaticResource HeadingTextStyle}" />

                            <TextBlock Text="{loc:T Players.EnterName}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="{loc:T Players.SelectColor}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding CheckerColors}" SelectedItem="{Binding CheckerColor}" Margin="0,0,0,16">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}, ConverterParameter=Color}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{loc:T Players.SelectSide}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{loc:T Players.Upper}" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding GameDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:GameDirection.Top}}" />
                                <RadioButton Content="{loc:T Players.Lower}" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding GameDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:GameDirection.Bottom}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
            <TextBlock Text="{loc:T Players.Variant}" Style="{StaticResource LabelTextStyle}" FontSize="18" />
            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}, ConverterParameter=Variant}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="{loc:T Common.MainMenu}" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="MainMenu" Margin="12" />
            <Button Content="{loc:T Players.Start}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="StartGame" Margin="12" />
        </StackPanel>
    </StackPanel>
</UserControl>
