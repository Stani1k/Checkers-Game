<UserControl x:Class="Checkers.WPF.Players.PlayerMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Checkers.Tools.Models;assembly=Checkers.Tools"
             xmlns:players="clr-namespace:Checkers.WPF.Players"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance players:PlayerMenuViewModel}">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="New Game" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,24" />

        <ItemsControl ItemsSource="{Binding Players}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="12" Width="420">
                        <StackPanel>
                            <TextBlock Text="{Binding PlayerNumberText}" Style="{StaticResource HeadingTextStyle}" />

                            <TextBlock Text="{StaticResource EnterName}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="{StaticResource SelectCheckerColor}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding CheckerColors}" SelectedItem="{Binding CheckerColor}" Margin="0,0,0,16" />

                            <TextBlock Text="{StaticResource SelectPlayingSite}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Upper" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding GameDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:GameDirection.Top}}" />
                                <RadioButton Content="Lower" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding GameDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:GameDirection.Bottom}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
            <TextBlock Text="Variant" Style="{StaticResource LabelTextStyle}" FontSize="18" />
            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Main Menu" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="MainMenu" Margin="12" />
            <Button Content="Start Game" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="StartGame" Margin="12" />
        </StackPanel>
    </StackPanel>
</UserControl>
