<UserControl x:Class="Checkers.WPF.Players.OnlineMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:players="clr-namespace:Checkers.WPF.Players"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance players:OnlineMenuViewModel}">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{loc:T Online.Title}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,24" HorizontalAlignment="Center" />

        <Border Style="{StaticResource CardStyle}" Width="520">
            <StackPanel>
                <TextBlock Text="{loc:T Online.Server}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,16" />

                <TextBlock Text="{loc:T Players.EnterName}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" IsEnabled="{Binding CanEdit}" Margin="0,0,0,16" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{loc:T Online.ShareCode}" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Text="{Binding GameCode, Mode=OneWay}" IsReadOnly="True" FontSize="32" FontWeight="Bold" Margin="0,6,0,12" />
                    <TextBlock Text="{loc:T Online.Waiting}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{loc:T Players.Variant}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}, ConverterParameter=Variant}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{loc:T Online.Create}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}" />

                    <TextBlock Text="{loc:T Online.EnterCode}" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" CharacterCasing="Upper" Margin="0,0,0,12" />
                    <Button Content="{loc:T Online.Join}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding JoinCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Content="{loc:T Common.Back}" Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
