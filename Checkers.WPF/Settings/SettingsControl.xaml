<UserControl x:Class="Checkers.WPF.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{StaticResource SettingsViewModel}">
    <UserControl.Resources>
        <local:SettingsViewModel x:Key="SettingsViewModel" />
    </UserControl.Resources>
    
    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <CheckBox Checked="FullSizeCheckbox_OnChecked">Switch Window State</CheckBox>
            <ComboBox Margin="0,10"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"/>
            
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="DarkMode" GroupName="theme" 
                             Checked="RadioButton_OnChecked"
                             Style="{StaticResource RadioButtonStyle}">
                    <WrapPanel>
                        <TextBlock Text="Dark Mode"/>
                    </WrapPanel>
                </RadioButton>
                <RadioButton Name="LightMode" GroupName="theme"
                             Checked="RadioButton_OnChecked"
                             Style="{StaticResource RadioButtonStyle}">
                    <WrapPanel>
                        <TextBlock Text="Light Mode" />
                    </WrapPanel>
                </RadioButton>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
