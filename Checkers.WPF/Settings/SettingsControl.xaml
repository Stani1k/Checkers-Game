<UserControl x:Class="Checkers.WPF.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.Settings"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance local:SettingsViewModel}">

    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="48,40" MinWidth="420">
        <StackPanel>
            <TextBlock Text="{loc:T Settings.Title}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,28" />

            <TextBlock Text="{loc:T Settings.Language}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,24">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumConverter}, ConverterParameter=Language}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{loc:T Settings.Theme}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <RadioButton GroupName="theme" Content="{loc:T Settings.Dark}" IsChecked="{Binding IsDarkTheme}" />
                <RadioButton GroupName="theme" Content="{loc:T Settings.Light}"
                             IsChecked="{Binding IsDarkTheme, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>

            <CheckBox Content="{loc:T Settings.Maximized}" IsChecked="{Binding IsMaximized}" />

            <Button Content="{loc:T Settings.Back}" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding UpdateViewCommand}" CommandParameter="MainMenu" Margin="0,28,0,0" />
        </StackPanel>
    </Border>
</UserControl>
