<UserControl x:Class="Checkers.WPF.MainMenu.MainMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mainMenu="clr-namespace:Checkers.WPF.MainMenu"
             xmlns:loc="clr-namespace:Checkers.WPF.Localization"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance mainMenu:MainMenuViewModel}">

    <Grid>
        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="56,44">
            <StackPanel>
                <Viewbox Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Canvas Width="80" Height="80">
                        <Rectangle Width="80" Height="80" RadiusX="10" RadiusY="10" Fill="#EBD9B4" />
                        <Path Fill="#8B5E3C" Data="M0,0 H20 V20 H0 Z M40,0 H60 V20 H40 Z M20,20 H40 V40 H20 Z M60,20 H80 V40 H60 Z M0,40 H20 V60 H0 Z M40,40 H60 V60 H40 Z M20,60 H40 V80 H20 Z M60,60 H80 V80 H60 Z" />
                        <Ellipse Canvas.Left="23" Canvas.Top="23" Width="34" Height="34"
                                 Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="2.5" />
                    </Canvas>
                </Viewbox>

                <TextBlock Text="CHECKERS" FontSize="48" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T Menu.Subtitle}" FontSize="16"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,32" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap" MaxWidth="320"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="{loc:T Menu.Continue}" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasSavedGame}"
                        Command="{Binding UpdateViewCommand}" CommandParameter="ContinueGame" />
                <Button Content="{loc:T Menu.Play}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding UpdateViewCommand}" CommandParameter="Play" />
                <Button Content="{loc:T Menu.Rules}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding UpdateViewCommand}" CommandParameter="Rules" />
                <Button Content="{loc:T Menu.Settings}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding UpdateViewCommand}" CommandParameter="Settings" />
                <Button Content="{loc:T Menu.Quit}" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Quit_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

