<UserControl x:Class="Checkers.WPF.MainMenu.MainMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Checkers.WPF.MainMenu"
             xmlns:gameMenu="clr-namespace:Checkers.WPF.GameMenu"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MainMenu"
             DataContext="{Binding ElementName=MainMenu, Path=ViewModel}">
    
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style x:Key="MainMenuButtonStyle" TargetType="Button">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </StackPanel.Resources>
            <Button Content="Start Game" Style="{StaticResource MainMenuButtonStyle}" />
            <Button Content="Settings"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Click="OpenSettings_OnClick"/>
            <Button Content="Quit"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Click="Quit_OnClick"/>
        </StackPanel>
    </Grid>
</UserControl>
